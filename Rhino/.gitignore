## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ins.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017 cache/options directory
.vs/

# Mac
.DS_Store

# ReSharper is a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Profiler
*.psess
*.vsp
*.vspx
*.sap

# Auto-generated `scratch` directory for agent
scratch/

# Local tooling and generated calibration runs
.claude/settings.local.json
.venv*/
__pycache__/
*.py[cod]
Checks/calibration/

yak/out/
