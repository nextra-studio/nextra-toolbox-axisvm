<?xml version="1.0" encoding="utf-8"?>
<!--
  Live checks for Functions/LoadPanelOps.cs. Needs a running AxisVM with a model open: test geometry is built
  at x >= 100 m, every operation is run and checked, and everything created is deleted again. The ops file is
  compiled in by link, so these checks always test exactly what the add-on ships.
  Build:  MSBuild Checks\LoadPanelToolsLiveChecks.csproj /p:Configuration=Debug
  Run:    Checks\bin\Debug\LoadPanelToolsLiveChecks.exe   (exit code 0 = all passed)
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{5A0C2E7D-8B14-4F36-A9D2-3C6E1B7F4D58}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>AxisVM_plugin.Checks</RootNamespace>
    <AssemblyName>LoadPanelToolsLiveChecks</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Interop.AxisVM.FW4">
      <HintPath>..\..\..\..\..\..\..\..\AXISVM X8\Interop.AxisVM.FW4.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\AxisVM plugin\Functions\LoadPanelOps.cs">
      <Link>LoadPanelOps.cs</Link>
    </Compile>
    <Compile Include="LoadPanelToolsLiveChecks.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
